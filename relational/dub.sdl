name "relational"
description "Relational in-memory database with a hexagonal / Clean Architecture and a vibe.d REST API"
homepage "https://www.sueel.de/uim/framework"
authors "Ozan Nurettin Süel" "UI Manufaktur"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

dependency "vibe-d" version="~>0.10.3"

targetName "uim-databases-relational"

// Embeddable library: all layers, no main.
configuration "library" {
	targetType "library"
	excludedSourceFiles "source/app.d"
}

// REST server: dub run -c executable (reads config/default.json from the working directory)
configuration "executable" {
	targetType "executable"
	targetName "relational"
	mainSourceFile "source/app.d"
}
