name "geodb"
description "A geospatial database with a clean/hexagonal architecture and a vibe.d REST API"
homepage "https://www.sueel.de/uim/framework"
authors "Ozan Nurettin Süel" "UI Manufaktur"
copyright "Copyright © 2018-2026, Ozan Nurettin Süel"
license "Apache-2.0"

dependency "vibe-d" version="~>0.10.3"

targetName "uim-databases-geodb"

// Embeddable library: domain, application, adapters (no main).
configuration "library" {
	targetType "library"
	excludedSourceFiles "source/app.d"
}

// REST server: dub run -c executable
configuration "executable" {
	targetType "executable"
	targetName "geodb"
	mainSourceFile "source/app.d"
}
