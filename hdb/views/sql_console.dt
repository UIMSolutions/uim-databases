extends layout

block content
  - if (view.transaction.length)
    div.alert.alert-warning.mb-4(role="status")
      i(data-lucide="lock", class="w-5 h-5")
      span Transaction open. Everyone else is locked out until you finish it. It rolls back after 30 seconds without activity.
      div.flex.gap-2
        form(action="/admin/sql", method="POST")
          input(type="hidden", name="transaction", value=view.transaction)
          input(type="hidden", name="statement", value="COMMIT")
          button.btn.btn-sm.btn-success(type="submit") Commit
        form(action="/admin/sql", method="POST")
          input(type="hidden", name="transaction", value=view.transaction)
          input(type="hidden", name="statement", value="ROLLBACK")
          button.btn.btn-sm(type="submit") Roll back

  form#sql-form.mb-6(action="/admin/sql", method="POST")
    input(type="hidden", name="transaction", value=view.transaction)
    textarea#sql-input.textarea.w-full.h-40.font-mono(name="statement", aria-label="SQL statements", placeholder="SELECT * FROM table_name LIMIT 10", spellcheck="false", autofocus=true) #{view.input}
    div.flex.items-center.justify-between.gap-2.mt-2
      span.text-xs.opacity-70 Separate statements with a semicolon. Execution stops at the first error.
      button.btn.btn-primary.btn-sm(type="submit")
        i(data-lucide="play", class="w-4 h-4")
        | Run (Ctrl+Enter)

  - foreach (r; view.results)
    div.card.bg-base-100.shadow.mb-4
      div.card-body.p-4
        div.flex.items-start.justify-between.gap-4
          code.text-sm.break-all.min-w-0 #{r.sql}
          span.text-xs.opacity-70.whitespace-nowrap #{r.elapsed}
        - if (r.error.length)
          div.alert.alert-error(role="alert")
            span.break-words.min-w-0 #{r.error}
        - else if (r.columns.length)
          div.overflow-x-auto.max-h-96
            table.table.table-sm.table-pin-rows
              thead
                tr
                  - foreach (c; r.columns)
                    th.font-mono #{c}
              tbody
                - foreach (row; r.rows)
                  tr
                    - foreach (c; row)
                      - if (c.isNull)
                        td
                          span.badge.badge-ghost.badge-xs NULL
                      - else
                        td.font-mono #{c.text}
          - if (r.rows.length < r.totalRows)
            p.text-sm.opacity-70 Showing the first #{r.rows.length} of #{r.totalRows} rows.
          - else
            p.text-sm.opacity-70 #{r.totalRows} row(s)
        - else
          p.text-sm.opacity-70 #{r.message}
