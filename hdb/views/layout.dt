doctype html
html(lang="en", data-theme="dark")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{page.title} - hdb Admin
    link(rel="icon", href="data:,")
    link(href="https://cdn.jsdelivr.net/npm/daisyui@5.7.50/daisyui.css", rel="stylesheet", type="text/css")
    script(src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4")
    script(src="https://unpkg.com/lucide@latest")

  body.bg-base-200.min-h-screen
    div.drawer(class="lg:drawer-open")
      input#admin-drawer.drawer-toggle(type="checkbox")

      div.drawer-content.flex.flex-col.min-w-0
        div.navbar.bg-base-100.border-b.border-base-300
          div.flex-none(class="lg:hidden")
            label.btn.btn-square.btn-ghost(for="admin-drawer", aria-label="Open navigation")
              i(data-lucide="menu")
          div.flex-1.px-4
            h1.text-xl.font-bold #{page.title}

        main.p-6.flex-1.min-w-0
          - if (page.locked)
            div.alert.alert-warning.mb-4(role="alert")
              i(data-lucide="lock", class="w-5 h-5")
              span An open transaction is locking the database. It rolls back after 30 seconds without activity.
          - if (page.ok.length)
            div.alert.alert-success.mb-4(role="status")
              i(data-lucide="circle-check", class="w-5 h-5")
              span #{page.ok}
          - if (page.err.length)
            div.alert.alert-error.mb-4(role="alert")
              i(data-lucide="circle-alert", class="w-5 h-5")
              span.break-words.min-w-0 #{page.err}
          block content

      div.drawer-side
        label.drawer-overlay(for="admin-drawer", aria-label="Close navigation")
        aside.bg-base-100.w-72.min-h-full.border-r.border-base-300.flex.flex-col
          div.p-4.border-b.border-base-300.flex.items-center.gap-2
            i.text-primary(data-lucide="database", class="w-6 h-6")
            span.text-xl.font-black.tracking-wide hdb Admin

          ul.menu.p-4.w-full.grow.gap-1
            - if (page.isSystem)
              li
                a(href="/admin/tenants", class=page.active == "tenants" ? "menu-active" : "")
                  i(data-lucide="building-2", class="w-4 h-4")
                  | Tenants
              li
                a(href="/admin/users", class=page.active == "users" ? "menu-active" : "")
                  i(data-lucide="shield-user", class="w-4 h-4")
                  | System administrators
              li
                a(href="/admin/help", class=page.active == "help" ? "menu-active" : "")
                  i(data-lucide="circle-help", class="w-4 h-4")
                  | Help
            - else
              li
                a(href="/admin", class=page.active == "dashboard" ? "menu-active" : "")
                  i(data-lucide="layout-dashboard", class="w-4 h-4")
                  | Dashboard
              li
                a(href="/admin/sql", class=page.active == "sql" ? "menu-active" : "")
                  i(data-lucide="terminal", class="w-4 h-4")
                  | SQL Console
              li
                a(href="/admin/stats", class=page.active == "stats" ? "menu-active" : "")
                  i(data-lucide="chart-column", class="w-4 h-4")
                  | Statistics
              li
                a(href="/admin/help", class=page.active == "help" ? "menu-active" : "")
                  i(data-lucide="circle-help", class="w-4 h-4")
                  | Help

              li.menu-title.mt-4 Tables
              - foreach (t; page.tables)
                li
                  a.font-mono(href="/admin/tables/#{t}", class=page.active == t ? "menu-active" : "")
                    i(data-lucide="table-2", class="w-4 h-4")
                    | #{t}
              - if (page.tables.length == 0)
                li.px-3.py-1.text-sm.opacity-60 No tables yet

              li.menu-title.mt-4 Apps
              li
                a(href="/ui5/")
                  i(data-lucide="app-window", class="w-4 h-4")
                  | Fiori client

              - if (page.isAdmin)
                li.menu-title.mt-4 Access
                li
                  a(href="/admin/users", class=page.active == "users" ? "menu-active" : "")
                    i(data-lucide="users", class="w-4 h-4")
                    | Users
                li
                  a(href="/admin/backups", class=page.active == "backups" ? "menu-active" : "")
                    i(data-lucide="archive", class="w-4 h-4")
                    | Backups

          div.p-4.border-t.border-base-300
            div.flex.items-center.justify-between.gap-2.mb-2
              a.link.link-hover.font-medium.truncate(href="/admin/account") #{page.userName}
              span.badge.badge-ghost.badge-sm #{page.roleLabel}
            div.flex.items-center.gap-1.mb-2.text-xs.opacity-70(title="Tenant")
              i(data-lucide="building-2", class="w-3 h-3")
              span.font-mono.truncate #{page.tenant}
            form(action="/admin/logout", method="POST")
              button.btn.btn-sm.btn-ghost.w-full(type="submit")
                i(data-lucide="log-out", class="w-4 h-4")
                | Sign out

    script(src="/admin.js")
