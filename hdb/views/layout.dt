doctype html
html(lang="en", data-theme="dark")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title #{pageTitle} - Admin Portal
    link(href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css", rel="stylesheet", type="text/css")
    script(src="https://cdn.tailwindcss.com")
    script(src="https://unpkg.com/lucide@latest")

  body.bg-base-200.min-h-screen
    div.drawer(class="lg:drawer-open")
      input#admin-drawer.drawer-toggle(type="checkbox")
      
      div.drawer-content.flex.flex-col
        // Navbar
        div.navbar.bg-base-100.border-b.border-base-300
          div.flex-none(class="lg:hidden")
            label.btn.btn-square.btn-ghost(for="admin-drawer")
              i(data-lucide="menu")
          div.flex-1.px-4
            h1.text-xl.font-bold #{pageTitle}
          div.flex-none.gap-2.px-4
            div.dropdown.dropdown-end
              label.btn.btn-ghost.btn-circle.avatar(tabindex="0")
                div.w-10.rounded-full
                  img(src="https://api.dicebear.com/7.x/identicon/svg?seed=Admin", alt="avatar")
              ul.dropdown-content.menu.m-2.p-2.shadow.bg-base-100.rounded-box.w-52(tabindex="0")
                li: a Profile
                li: a Settings
                li: a.text-error Logout

        // Main View Content Container
        main.p-6.flex-1
          block content

      // Sidebar Navigation
      div.drawer-side
        label.drawer-overlay(for="admin-drawer")
        aside.bg-base-100.w-80.min-h-full.border-r.border-base-300.flex.flex-col
          div.p-4.border-b.border-base-300.flex.items-center.gap-2
            i.text-primary(data-lucide="database", class="w-6 h-6")
            span.text-xl.font-black.tracking-wide DB Admin
          
          ul.menu.p-4.w-full.grow.gap-1
            li.menu-title Database Tables
            li
              a(href="/admin/users", class=activeTable == "users" ? "active" : "")
                i(data-lucide="users", class="w-4 h-4")
                | Users
            li
              a(href="/admin/orders", class=activeTable == "orders" ? "active" : "")
                i(data-lucide="shopping-cart", class="w-4 h-4")
                | Orders
            li
              a(href="/admin/products", class=activeTable == "products" ? "active" : "")
                i(data-lucide="package", class="w-4 h-4")
                | Products
            
            li.menu-title.mt-4 System
            li
              a(href="/admin/settings")
                i(data-lucide="settings", class="w-4 h-4")
                | Maintenance

    script.
      lucide.createIcons();