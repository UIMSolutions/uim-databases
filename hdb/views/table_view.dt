extends layout

block content
  div.flex.flex-wrap.items-center.justify-between.gap-3.mb-4
    p.text-sm.opacity-70
      span.badge.badge-ghost.badge-sm.mr-2 #{view.storage}
      | #{view.live} live rows · #{view.deleted} deleted · #{view.columns.length} columns
    div.flex.flex-wrap.gap-2
      - if (view.canInsert)
        button.btn.btn-primary.btn-sm(type="button", data-row-insert="1")
          i(data-lucide="plus", class="w-4 h-4")
          | Add row
      a.btn.btn-sm(href=view.consoleUrl)
        i(data-lucide="terminal", class="w-4 h-4")
        | Open in console
      a.btn.btn-sm(href=view.exportUrl)
        i(data-lucide="download", class="w-4 h-4")
        | Export CSV
      - if (view.canDelete)
        form(action="/admin/tables/#{view.name}/truncate", method="POST", data-confirm="Delete all rows in #{view.name}?")
          button.btn.btn-sm.btn-outline.btn-warning(type="submit") Delete all rows
      - if (view.canDrop)
        form(action="/admin/tables/#{view.name}/drop", method="POST", data-confirm-name=view.name)
          button.btn.btn-sm.btn-outline.btn-error(type="submit") Drop table

  form.flex.flex-wrap.gap-2.mb-4(method="GET")
    - if (view.sort.length)
      input(type="hidden", name="sort", value=view.sort)
      input(type="hidden", name="dir", value=view.desc ? "desc" : "asc")
    input.input.input-sm.grow.font-mono.min-w-0(type="text", name="where", value=view.where, placeholder="WHERE condition, e.g. amount >= 10 AND name LIKE 'A%'", aria-label="WHERE condition")
    select.select.select-sm.w-32(name="size", aria-label="Rows per page", data-autosubmit="1")
      - foreach (n; [25, 50, 100, 250, 500])
        option(value="#{n}", selected=view.pageSize == n) #{n} rows
    button.btn.btn-sm(type="submit") Filter
    - if (view.where.length)
      a.btn.btn-sm.btn-ghost(href="/admin/tables/#{view.name}") Clear

  - if (view.queryError.length)
    div.alert.alert-error.mb-4(role="alert")
      span.break-words.min-w-0 #{view.queryError}

  div.card.bg-base-100.shadow.mb-6
    div.overflow-x-auto
      table.table.table-zebra.table-sm
        thead
          tr
            - foreach (c; view.columns)
              th
                a.link.link-hover.font-mono(href=view.sortUrl(c.name)) #{c.name}#{view.sortMark(c.name)}
                span.block.text-xs.font-normal.opacity-60 #{c.type}
            - if (view.canUpdate || view.canDelete)
              th.text-right Actions
        tbody
          - foreach (row; view.rows)
            tr(data-values=row.match)
              - foreach (i, c; row.cells)
                - if (c.isNull)
                  td
                    span.badge.badge-ghost.badge-xs NULL
                - else if (view.columns[i].type == "LINK")
                  td.font-mono.max-w-xs.truncate(title=c.text)
                    a.link(href=c.text, target="_blank", rel="noopener noreferrer") #{c.text}
                - else
                  td.font-mono.max-w-xs.truncate(title=c.text) #{c.text}
              - if (view.canUpdate || view.canDelete)
                td.text-right.whitespace-nowrap
                  - if (view.canUpdate)
                    button.btn.btn-square.btn-ghost.btn-xs(type="button", data-row-edit="1", title="Edit row", aria-label="Edit row")
                      i(data-lucide="pencil", class="w-4 h-4")
                  - if (view.canDelete)
                    form.inline(action="/admin/tables/#{view.name}/rows/delete", method="POST", data-confirm="Delete this row? Rows with identical values are deleted too.")
                      input(type="hidden", name="match", value=row.match)
                      input(type="hidden", name="back", value=view.backQuery)
                      button.btn.btn-square.btn-ghost.btn-xs.text-error(type="submit", title="Delete row", aria-label="Delete row")
                        i(data-lucide="trash-2", class="w-4 h-4")
          - if (view.rows.length == 0 && view.queryError.length == 0)
            tr
              td.text-center.opacity-70.py-6(colspan="#{view.columns.length + 1}") No rows found

    div.p-4.border-t.border-base-300.flex.flex-col.items-center.justify-between.gap-4(class="sm:flex-row")
      span.text-sm.opacity-70 Showing #{view.firstRow} to #{view.lastRow} of #{view.matching} rows
      div.join
        a.btn.btn-sm.join-item(href=view.pageUrl(view.page - 1), class=view.page <= 1 ? "btn-disabled" : "") «
        span.btn.btn-sm.join-item.no-animation Page #{view.page} of #{view.pageCount}
        a.btn.btn-sm.join-item(href=view.pageUrl(view.page + 1), class=view.page >= view.pageCount ? "btn-disabled" : "") »

  div.card.bg-base-100.shadow
    div.card-body
      h2.card-title Column storage
      div.overflow-x-auto
        table.table.table-sm
          thead
            tr
              th Column
              th Type
              th.text-right Main rows
              th.text-right Delta rows
              th.text-right Main distinct
              th.text-right Delta distinct
              th.text-right Bits per value
              th.text-right Main codes
          tbody
            - foreach (c; view.columns)
              tr
                td.font-mono #{c.name}
                td #{c.type}
                td.text-right #{c.stats.mainRows}
                td.text-right #{c.stats.deltaRows}
                td.text-right #{c.stats.mainDistinct}
                td.text-right #{c.stats.deltaDistinct}
                td.text-right #{c.stats.mainBits}
                td.text-right #{c.codeSize}

  - if (view.canInsert || view.canUpdate)
    dialog#row_modal.modal
      div.modal-box
        h3#row-title.font-bold.text-lg.mb-4 Add row
        p#row-duplicate-note.text-xs.opacity-70.mb-4.hidden Rows with identical values are updated too.
        form#row-form(method="POST", data-insert="/admin/tables/#{view.name}/rows", data-update="/admin/tables/#{view.name}/rows/update")
          input#row-match(type="hidden", name="match", value="")
          input(type="hidden", name="back", value=view.backQuery)
          - foreach (i, c; view.columns)
            div.mb-3
              label.block.text-sm.mb-1(for="row-v#{i}")
                span.font-mono #{c.name}
                span.opacity-60  #{c.type}
              div.flex.items-center.gap-3
                - if (c.inputType == "text")
                  input.input.grow.min-w-0(id="row-v#{i}", type="text", name="v#{i}", data-field="#{i}", autocomplete="off")
                - else if (c.inputType == "integer")
                  input.input.grow.min-w-0(id="row-v#{i}", type="number", step="1", name="v#{i}", data-field="#{i}", autocomplete="off")
                - else
                  input.input.grow.min-w-0(id="row-v#{i}", type="number", step="any", name="v#{i}", data-field="#{i}", autocomplete="off")
                label.flex.items-center.gap-1.text-sm
                  input.checkbox.checkbox-sm(type="checkbox", name="n#{i}", value="1", data-null="#{i}")
                  | NULL
          div.modal-action
            button.btn.btn-ghost(type="button", onclick="row_modal.close()") Cancel
            button.btn.btn-primary(type="submit") Save
