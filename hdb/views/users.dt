extends layout

block content
  div.card.bg-base-100.shadow
    div.card-body
      div.flex.items-center.justify-between.gap-2
        h2.card-title Users
        button.btn.btn-primary.btn-sm(type="button", onclick="user_modal.showModal()")
          i(data-lucide="user-plus", class="w-4 h-4")
          | New user
      - if (page.isSystem)
        p.text-sm.opacity-70 Users of the system area. Their role decides what they can do on the server: see or manage tenants, and manage system users. They can't see tenant data.
      - else
        p.text-sm.opacity-70
          | Users of tenant #{page.tenant}. The role applies to all tables. Table access adds roles for single tables, so a user without a role sees only those tables. Define your own roles under
          a.link.ml-1(href="/admin/roles") Roles
          | .
      div.overflow-x-auto
        table.table
          thead
            tr
              th Name
              th Role
              - if (view.tables)
                th Table access
              th Status
              th.text-right Actions
          tbody
            - foreach (u; view.users)
              tr
                td
                  span.font-mono #{u.name}
                  - if (u.self)
                    span.badge.badge-ghost.badge-sm.ml-2 You
                td
                  form(action="/admin/users/#{u.name}/update", method="POST")
                    - if (u.active)
                      input(type="hidden", name="active", value="1")
                    select.select.select-sm.w-40(name="role", aria-label="Role of #{u.name}", data-autosubmit="1")
                      - if (view.tables)
                        option(value="", selected=u.role.length == 0) (none)
                      - foreach (r; view.roles)
                        option(value=r, selected=r == u.role) #{r}
                - if (view.tables)
                  td
                    a.link.link-hover.text-sm(href="/admin/users/#{u.name}/grants") #{u.grants == 0 ? "None" : u.grants == 1 ? "1 grant" : u.grants.to!string ~ " grants"}
                td
                  - if (u.active)
                    span.badge.badge-success.badge-sm Active
                  - else
                    span.badge.badge-ghost.badge-sm Disabled
                td.text-right.whitespace-nowrap
                  form.inline(action="/admin/users/#{u.name}/update", method="POST")
                    input(type="hidden", name="role", value=u.role)
                    - if (!u.active)
                      input(type="hidden", name="active", value="1")
                    button.btn.btn-ghost.btn-xs(type="submit") #{u.active ? "Disable" : "Enable"}
                  button.btn.btn-ghost.btn-xs(type="button", data-reset-user=u.name) Reset password
                  form.inline(action="/admin/users/#{u.name}/delete", method="POST", data-confirm="Delete user #{u.name}?")
                    button.btn.btn-ghost.btn-xs.text-error(type="submit") Delete

  dialog#user_modal.modal
    div.modal-box
      h3.font-bold.text-lg.mb-4 New user
      form(action="/admin/users", method="POST")
        label.block.mb-3
          span.block.text-sm.mb-1 User name
          input.input.w-full.font-mono(type="text", name="user", required=true, autocomplete="off")
        label.block.mb-3
          span.block.text-sm.mb-1 Role
          select.select.w-full(name="role")
            - foreach (r; view.roles)
              option(value=r, selected=r == "viewer") #{r}
            - if (view.tables)
              option(value="") (none: table access only)
        label.block.mb-3
          span.block.text-sm.mb-1 Password (at least 12 characters)
          input.input.w-full(type="password", name="password", required=true, minlength="12", autocomplete="new-password")
        label.block.mb-3
          span.block.text-sm.mb-1 Repeat password
          input.input.w-full(type="password", name="confirm", required=true, minlength="12", autocomplete="new-password")
        div.modal-action
          button.btn.btn-ghost(type="button", onclick="user_modal.close()") Cancel
          button.btn.btn-primary(type="submit") Create user

  dialog#reset_modal.modal
    div.modal-box
      h3#reset-title.font-bold.text-lg.mb-4 Reset password
      p.text-sm.opacity-70.mb-4 This signs the user out everywhere.
      form#reset-form(method="POST")
        label.block.mb-3
          span.block.text-sm.mb-1 New password (at least 12 characters)
          input.input.w-full(type="password", name="password", required=true, minlength="12", autocomplete="new-password")
        label.block.mb-3
          span.block.text-sm.mb-1 Repeat password
          input.input.w-full(type="password", name="confirm", required=true, minlength="12", autocomplete="new-password")
        div.modal-action
          button.btn.btn-ghost(type="button", onclick="reset_modal.close()") Cancel
          button.btn.btn-primary(type="submit") Reset password
