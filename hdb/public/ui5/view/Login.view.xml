<mvc:View controllerName="hdb.client.controller.Login" xmlns="sap.m" xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core">
	<FlexBox width="100%" justifyContent="Center">
	<Panel width="22rem" backgroundDesign="Solid">
		<VBox class="sapUiSmallMargin">
			<Title text="{i18n>loginTitle}" titleStyle="H3" class="sapUiSmallMarginBottom"/>
			<MessageStrip text="{app>/loginError}" type="Error" visible="{= !!${app>/loginError} }" class="sapUiSmallMarginBottom"/>
			<Label text="{i18n>loginUser}" labelFor="user"/>
			<Input id="user" submit=".onLogin"/>
			<Label text="{i18n>loginPassword}" labelFor="password" class="sapUiTinyMarginTop"/>
			<Input id="password" type="Password" submit=".onLogin"/>
			<Button id="signIn" text="{i18n>loginTitle}" type="Emphasized" width="100%" press=".onLogin" class="sapUiSmallMarginTop"/>
		</VBox>
	</Panel>
	</FlexBox>
</mvc:View>
